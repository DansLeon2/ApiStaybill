# ==========================================
# StayBill Global .gitignore
# ==========================================

# --- Environment & Credentials ---
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!**/.env.example

# --- AI Assistants & Temporary Metadata ---
.aider*
.gemini/
.claude/

# --- Python Cache & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
env/
venv/
.venv/

# --- Node & Frontend Build Artifacts ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# --- Java & Maven Build Artifacts ---
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar
staybill/oracleJdk-21/

# --- IDE & Editor Settings ---
.idea/
*.iws
*.iml
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs & Temp ---
logs/
*.log
tmp/
temp/
